// Loads every picture the game draws through the Playabl asset handle, reads
// the slicing sidecars, and prepares tinted copies (hazed distant trees, the
// shaded far-side limbs) once, so drawing never filters per frame.
import manifest from "../assets.json";

const IMAGE_KEYS = [
  "SKY_BACKDROP", "FOREST_HILLS", "TREELINE_MID", "PINE_TREE", "OAK_TREE",
  "TRAIL_PROPS", "DIRT_TEXTURE", "BIKE_BODY", "BIKE_PARTS", "RIDER_PARTS",
];
const SHEETS = ["TRAIL_PROPS", "BIKE_PARTS", "RIDER_PARTS"];
const CUTOUTS = ["FOREST_HILLS", "TREELINE_MID", "PINE_TREE", "OAK_TREE", "TRAIL_PROPS", "BIKE_BODY", "BIKE_PARTS", "RIDER_PARTS"];

function loadImage(key, url) {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.decoding = "async";
    img.onload = () => resolve(img);
    img.onerror = () => reject(new Error(`Image ${key} failed to load`));
    img.src = url;
  });
}

function toCanvas(img) {
  const c = document.createElement("canvas");
  c.width = img.naturalWidth || img.width;
  c.height = img.naturalHeight || img.height;
  c.getContext("2d").drawImage(img, 0, 0);
  return c;
}

// Chroma-key fringes: pull neon green spill back to the neighbouring warm tones.
function despill(canvas) {
  const ctx = canvas.getContext("2d", { willReadFrequently: true });
  const data = ctx.getImageData(0, 0, canvas.width, canvas.height);
  const d = data.data;
  for (let i = 0; i < d.length; i += 4) {
    if (d[i + 3] === 0) continue;
    const r = d[i], g = d[i + 1], b = d[i + 2];
    const m = Math.max(r, b);
    const spill = g - m;
    if (spill > 38) {
      // Re-light the pixel as a warm sunlit leaf of the same brightness.
      const L = 0.3 * r + 0.59 * g + 0.11 * b;
      const k = Math.min(1, (spill - 38) / 60);
      d[i] = r + (L * 0.92 - r) * k;
      d[i + 1] = g + (L * 0.8 - g) * k;
      d[i + 2] = b + (L * 0.38 - b) * k;
    }
  }
  ctx.putImageData(data, 0, 0);
  return canvas;
}

export function tinted(source, color, alpha) {
  const c = document.createElement("canvas");
  c.width = source.width;
  c.height = source.height;
  const ctx = c.getContext("2d");
  ctx.drawImage(source, 0, 0);
  ctx.globalCompositeOperation = "source-atop";
  ctx.globalAlpha = alpha;
  ctx.fillStyle = color;
  ctx.fillRect(0, 0, c.width, c.height);
  return c;
}

export async function loadArt(assets) {
  const urls = Object.fromEntries(IMAGE_KEYS.map((k) => [k, assets ? assets.get(k) : manifest[k].src]));
  const [images, frames] = await Promise.all([
    Promise.all(IMAGE_KEYS.map((k) => loadImage(k, urls[k]))),
    Promise.all(
      SHEETS.map(async (k) => {
        const res = await fetch(manifest[k].src.replace(/\.(webp|png)$/, ".frames.json"));
        if (!res.ok) throw new Error(`Frames for ${k} failed to load`);
        const json = await res.json();
        return Object.fromEntries(json.frames.map((f) => [f.name, f]));
      }),
    ),
  ]);
  const art = {};
  IMAGE_KEYS.forEach((k, i) => {
    art[k] = CUTOUTS.includes(k) ? despill(toCanvas(images[i])) : images[i];
  });
  const frame = Object.fromEntries(SHEETS.map((k, i) => [k, frames[i]]));

  // Distance haze for tree layers, and shade for the limbs on the far side.
  art.haze = {
    PINE_TREE: [tinted(art.PINE_TREE, "#c9864a", 0.62), tinted(art.PINE_TREE, "#a8683a", 0.42), tinted(art.PINE_TREE, "#2a1a0e", 0.18)],
    OAK_TREE: [tinted(art.OAK_TREE, "#c9864a", 0.62), tinted(art.OAK_TREE, "#a8683a", 0.42), tinted(art.OAK_TREE, "#2a1a0e", 0.18)],
  };
  art.propsShade = tinted(art.TRAIL_PROPS, "#1d120a", 0.55);
  art.propsBack = tinted(art.TRAIL_PROPS, "#6b4524", 0.25);
  art.riderFar = tinted(art.RIDER_PARTS, "#140c08", 0.45);
  art.bikeFar = tinted(art.BIKE_PARTS, "#140c08", 0.25);
  return { art, frame };
}
// Synthesised sound: a single-cylinder engine whose pitch follows the
// simulated RPM, wind that rises with speed, an evening forest bed with the
// odd bird, and impacts whose weight follows the physics impulse.
export function createAudio(sdk) {
  let audio = null;
  let ctx = null;
  let nodes = null;
  let volume = 0.8;
  let muted = false;
  let birdTimer = 3;

  sdk.audio
    .getContext()
    .then((a) => {
      audio = a;
      ctx = a.context;
      build();
    })
    .catch(() => {});

  function noiseBuffer(seconds) {
    const len = Math.floor(ctx.sampleRate * seconds);
    const buf = ctx.createBuffer(1, len, ctx.sampleRate);
    const d = buf.getChannelData(0);
    let b = 0;
    for (let i = 0; i < len; i++) {
      // Lightly pinked noise: less hiss, more body.
      const w = Math.random() * 2 - 1;
      b = 0.97 * b + 0.03 * w;
      d[i] = w * 0.45 + b * 3.2;
    }
    return buf;
  }

  function loopNoise() {
    const src = ctx.createBufferSource();
    src.buffer = nodes.noise;
    src.loop = true;
    src.loopStart = Math.random();
    src.start(0, Math.random() * 1.5);
    return src;
  }

  function build() {
    nodes = {};
    nodes.master = ctx.createGain();
    nodes.master.gain.value = muted ? 0 : volume;
    nodes.master.connect(ctx.destination);
    nodes.noise = noiseBuffer(2.5);

    // Engine: crank-rate saw + half-rate square (the four-stroke thump) through a soft clipper.
    const e = {};
    e.saw = ctx.createOscillator();
    e.saw.type = "sawtooth";
    e.sub = ctx.createOscillator();
    e.sub.type = "square";
    e.saw2 = ctx.createOscillator();
    e.saw2.type = "sawtooth";
    e.saw2.detune.value = 9;
    e.mix = ctx.createGain();
    e.mix.gain.value = 0.5;
    e.shaper = ctx.createWaveShaper();
    const curve = new Float32Array(1024);
    for (let i = 0; i < 1024; i++) {
      const x = (i / 1023) * 2 - 1;
      curve[i] = Math.tanh(x * 2.6);
    }
    e.shaper.curve = curve;
    e.lp = ctx.createBiquadFilter();
    e.lp.type = "lowpass";
    e.lp.Q.value = 2.5;
    e.gain = ctx.createGain();
    e.gain.gain.value = 0;
    const subGain = ctx.createGain();
    subGain.gain.value = 0.8;
    const saw2Gain = ctx.createGain();
    saw2Gain.gain.value = 0.35;
    e.saw.connect(e.mix);
    e.sub.connect(subGain).connect(e.mix);
    e.saw2.connect(saw2Gain).connect(e.mix);
    e.mix.connect(e.shaper).connect(e.lp).connect(e.gain).connect(nodes.master);
    // Exhaust roar: band-limited noise that opens with the throttle.
    e.roar = loopNoise();
    e.roarBp = ctx.createBiquadFilter();
    e.roarBp.type = "bandpass";
    e.roarBp.Q.value = 1.2;
    e.roarGain = ctx.createGain();
    e.roarGain.gain.value = 0;
    e.roar.connect(e.roarBp).connect(e.roarGain).connect(nodes.master);
    e.saw.start();
    e.sub.start();
    e.saw2.start();
    nodes.engine = e;

    // Wind past the helmet.
    const w = {};
    w.src = loopNoise();
    w.hp = ctx.createBiquadFilter();
    w.hp.type = "highpass";
    w.hp.frequency.value = 380;
    w.gain = ctx.createGain();
    w.gain.gain.value = 0;
    w.src.connect(w.hp).connect(w.gain).connect(nodes.master);
    nodes.wind = w;

    // Forest bed: low breathing wind in the pines.
    const a = {};
    a.src = loopNoise();
    a.lp = ctx.createBiquadFilter();
    a.lp.type = "lowpass";
    a.lp.frequency.value = 520;
    a.gain = ctx.createGain();
    a.gain.gain.value = 0.05;
    a.src.connect(a.lp).connect(a.gain).connect(nodes.master);
    nodes.amb = a;

    // Tyre on loose dirt.
    const d = {};
    d.src = loopNoise();
    d.bp = ctx.createBiquadFilter();
    d.bp.type = "bandpass";
    d.bp.frequency.value = 900;
    d.bp.Q.value = 0.7;
    d.gain = ctx.createGain();
    d.gain.gain.value = 0;
    d.src.connect(d.bp).connect(d.gain).connect(nodes.master);
    nodes.dirt = d;
  }

  const running = () => nodes && ctx && ctx.state === "running";

  function unlock() {
    if (audio) audio.unlock().catch(() => {});
  }

  function setVolume(v, m) {
    volume = v;
    muted = m;
    if (nodes) nodes.master.gain.setTargetAtTime(muted ? 0 : volume, ctx.currentTime, 0.05);
  }

  // Called every frame from update with the simulation's summary.
  function update(dt, s) {
    if (!running()) return;
    const t = ctx.currentTime;
    const e = nodes.engine;
    const f = s.rpm / 60;
    const on = s.engineOn ? 1 : 0;
    e.saw.frequency.setTargetAtTime(f, t, 0.02);
    e.saw2.frequency.setTargetAtTime(f * 2, t, 0.02);
    e.sub.frequency.setTargetAtTime(f / 2, t, 0.02);
    e.lp.frequency.setTargetAtTime(180 + s.throttle * 1500 + (s.rpm / 12000) * 900, t, 0.03);
    e.gain.gain.setTargetAtTime(on * (0.07 + s.throttle * 0.11), t, 0.04);
    e.roarBp.frequency.setTargetAtTime(220 + f * 3, t, 0.03);
    e.roarGain.gain.setTargetAtTime(on * s.throttle * 0.06, t, 0.05);
    nodes.wind.gain.gain.setTargetAtTime(Math.min(0.22, (s.speed / 28) ** 2 * 0.2), t, 0.1);
    nodes.dirt.gain.gain.setTargetAtTime(Math.min(0.14, s.slip * 0.02 + s.rolling * 0.003), t, 0.05);
    const breathe = 0.04 + 0.025 * Math.sin(s.time * 0.21) + 0.015 * Math.sin(s.time * 0.53);
    nodes.amb.gain.gain.setTargetAtTime(breathe, t, 0.3);

    birdTimer -= dt;
    if (birdTimer <= 0) {
      birdTimer = 3 + Math.random() * 7;
      bird();
    }
  }

  function bird() {
    const t0 = ctx.currentTime;
    const notes = 2 + Math.floor(Math.random() * 4);
    const base = 2400 + Math.random() * 1600;
    for (let i = 0; i < notes; i++) {
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      const st = t0 + i * (0.09 + Math.random() * 0.06);
      o.type = "sine";
      o.frequency.setValueAtTime(base * (1 + Math.random() * 0.2), st);
      o.frequency.exponentialRampToValueAtTime(base * (1.25 + Math.random() * 0.3), st + 0.07);
      g.gain.setValueAtTime(0.0001, st);
      g.gain.exponentialRampToValueAtTime(0.018, st + 0.01);
      g.gain.exponentialRampToValueAtTime(0.0001, st + 0.08);
      o.connect(g).connect(nodes.master);
      o.start(st);
      o.stop(st + 0.1);
    }
  }

  // A thump with a burst of dirt; `weight` 0..1.
  function thud(weight, low = 1) {
    if (!running()) return;
    const t0 = ctx.currentTime;
    const w = Math.min(1, weight);
    const o = ctx.createOscillator();
    const og = ctx.createGain();
    o.type = "sine";
    o.frequency.setValueAtTime(95 * low, t0);
    o.frequency.exponentialRampToValueAtTime(42 * low, t0 + 0.22);
    og.gain.setValueAtTime(0.0001, t0);
    og.gain.exponentialRampToValueAtTime(0.5 * w + 0.05, t0 + 0.008);
    og.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.32);
    o.connect(og).connect(nodes.master);
    o.start(t0);
    o.stop(t0 + 0.35);
    const n = ctx.createBufferSource();
    n.buffer = nodes.noise;
    const lp = ctx.createBiquadFilter();
    lp.type = "lowpass";
    lp.frequency.value = 900 + w * 1400;
    const ng = ctx.createGain();
    ng.gain.setValueAtTime(0.0001, t0);
    ng.gain.exponentialRampToValueAtTime(0.35 * w + 0.03, t0 + 0.005);
    ng.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.18 + w * 0.2);
    n.connect(lp).connect(ng).connect(nodes.master);
    n.start(t0, Math.random() * 2);
    n.stop(t0 + 0.45);
  }

  // Plastic and metal hitting the ground.
  function clank(weight) {
    if (!running()) return;
    thud(weight * 0.7, 1.3);
    const t0 = ctx.currentTime;
    const w = Math.min(1, weight);
    for (const fr of [430, 1130, 1870]) {
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.type = "triangle";
      o.frequency.value = fr * (0.9 + Math.random() * 0.2);
      g.gain.setValueAtTime(0.0001, t0);
      g.gain.exponentialRampToValueAtTime(0.05 * w + 0.01, t0 + 0.004);
      g.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.12 + Math.random() * 0.15);
      o.connect(g).connect(nodes.master);
      o.start(t0);
      o.stop(t0 + 0.32);
    }
    const n = ctx.createBufferSource();
    n.buffer = nodes.noise;
    const bp = ctx.createBiquadFilter();
    bp.type = "bandpass";
    bp.frequency.value = 2600;
    bp.Q.value = 3;
    const ng = ctx.createGain();
    ng.gain.setValueAtTime(0.0001, t0);
    ng.gain.exponentialRampToValueAtTime(0.16 * w + 0.02, t0 + 0.003);
    ng.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.25);
    n.connect(bp).connect(ng).connect(nodes.master);
    n.start(t0, Math.random() * 2);
    n.stop(t0 + 0.3);
  }

  // UI blip for a new personal best.
  function chime() {
    if (!running()) return;
    const t0 = ctx.currentTime;
    [660, 880, 1320].forEach((fr, i) => {
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.type = "sine";
      o.frequency.value = fr;
      const st = t0 + i * 0.07;
      g.gain.setValueAtTime(0.0001, st);
      g.gain.exponentialRampToValueAtTime(0.06, st + 0.01);
      g.gain.exponentialRampToValueAtTime(0.0001, st + 0.35);
      o.connect(g).connect(nodes.master);
      o.start(st);
      o.stop(st + 0.4);
    });
  }

  return {
    unlock, update, thud, clank, chime, setVolume,
    destroy() {
      if (nodes) nodes.master.disconnect();
    },
  };
}
// The dirt bike as a machine: a heavy chassis, a telescopic fork that slides
// on a prismatic joint, a swingarm on a pivot, two wheels on bearings. The
// springs and dampers are forces computed every physics step; the engine is a
// torque at the rear axle. Nothing here keeps the bike upright.
import * as planck from "planck";
import { clamp, wrapAngle } from "./rng.js";

export const CAT_GROUND = 0x0001;
export const CAT_BIKE = 0x0002;
export const CAT_RIDER = 0x0004;

// Chassis sprite pixels → bike-local metres (origin between the axles).
export const BIKE_SPRITE = { ox: 735, oy: 600, pxPerM: 703 };
const P = (px, py) => ({ x: (px - BIKE_SPRITE.ox) / BIKE_SPRITE.pxPerM, y: -(py - BIKE_SPRITE.oy) / BIKE_SPRITE.pxPerM });

const forkLen = Math.hypot(275, 555);
export const GEOM = {
  wheelR: 0.345,
  pivot: P(575, 515),
  rearAxle: P(215, 665),
  frontAxle: P(1255, 665),
  forkUp: { x: -275 / forkLen, y: 555 / forkLen }, // compression direction
  peg: P(625, 655),
  grip: P(872, 40),
  sprocket: P(700, 556),
  frontTravel: 0.3,
  frontSag: 0.06,
  rearTravel: 0.32,
  rearSag: 0.09,
};
GEOM.swingLen = Math.hypot(GEOM.rearAxle.x - GEOM.pivot.x, GEOM.rearAxle.y - GEOM.pivot.y);
// Swingarm angle relative to the chassis at full droop: the body's local
// (-L, 0) points at the axle.
const nominalSwing = wrapAngle(Math.atan2(GEOM.rearAxle.y - GEOM.pivot.y, GEOM.rearAxle.x - GEOM.pivot.x) - Math.PI);
GEOM.swingRest = nominalSwing + GEOM.rearSag / GEOM.swingLen;
GEOM.frontAxleExt = {
  x: GEOM.frontAxle.x - GEOM.forkUp.x * GEOM.frontSag,
  y: GEOM.frontAxle.y - GEOM.forkUp.y * GEOM.frontSag,
};

// Convex collision hulls of the chassis (frame/engine, subframe, bars, fender).
const HULLS = [
  [P(480, 330), P(950, 230), P(1010, 520), P(900, 690), P(620, 700), P(520, 560)],
  [P(10, 262), P(500, 255), P(560, 470), P(200, 480)],
  [P(850, 18), P(960, 60), P(1010, 300), P(900, 280)],
  [P(1030, 250), P(1438, 330), P(1100, 312)],
];

const rot = (p, a) => ({ x: p.x * Math.cos(a) - p.y * Math.sin(a), y: p.x * Math.sin(a) + p.y * Math.cos(a) });

export function localToWorld(origin, angle, p) {
  const r = rot(p, angle);
  return { x: origin.x + r.x, y: origin.y + r.y };
}

function setMass(body, mass, center, inertiaAboutCenter) {
  body.setMassData({
    mass,
    center: planck.Vec2(center.x, center.y),
    I: inertiaAboutCenter + mass * (center.x * center.x + center.y * center.y),
  });
}

const bikeFilter = { filterCategoryBits: CAT_BIKE, filterMaskBits: CAT_GROUND | CAT_RIDER, filterGroupIndex: -1 };

// Builds the bike at rest pose with the chassis origin at `origin`, tilted by `angle`.
export function createBike(world, origin, angle) {
  const W = (p) => planck.Vec2(localToWorld(origin, angle, p));

  const chassis = world.createBody({ type: "dynamic", position: planck.Vec2(origin.x, origin.y), angle, bullet: true });
  for (const hull of HULLS) {
    chassis.createFixture(new planck.PolygonShape(hull.map((p) => planck.Vec2(p.x, p.y))), {
      density: 1, friction: 0.45, restitution: 0.12, ...bikeFilter, userData: { part: "chassis" },
    });
  }
  setMass(chassis, 86, { x: 0.0, y: 0.1 }, 14);

  // Swingarm: origin at the pivot, axle at local (-L, 0).
  const L = GEOM.swingLen;
  const swingAngle = angle + GEOM.swingRest;
  const swing = world.createBody({ type: "dynamic", position: W(GEOM.pivot), angle: swingAngle });
  swing.createFixture(new planck.BoxShape(L / 2, 0.04, planck.Vec2(-L / 2, 0), 0), {
    density: 1, friction: 0.4, ...bikeFilter, userData: { part: "swingarm" },
  });
  setMass(swing, 4.5, { x: -L * 0.45, y: 0 }, 4.5 * L * L / 12);
  const pivotJoint = world.createJoint(new planck.RevoluteJoint({
    bodyA: chassis, bodyB: swing,
    localAnchorA: planck.Vec2(GEOM.pivot.x, GEOM.pivot.y), localAnchorB: planck.Vec2(0, 0),
    referenceAngle: GEOM.swingRest,
    enableLimit: true, lowerAngle: -GEOM.rearTravel / L, upperAngle: 0,
  }));

  // Fork lower leg: origin at the front axle, slides along the fork axis.
  const forkAngle = Math.atan2(-GEOM.forkUp.x, GEOM.forkUp.y);
  const fork = world.createBody({ type: "dynamic", position: W(GEOM.frontAxleExt), angle });
  fork.createFixture(new planck.BoxShape(0.035, 0.17, planck.Vec2(GEOM.forkUp.x * 0.17, GEOM.forkUp.y * 0.17), forkAngle), {
    density: 1, friction: 0.4, ...bikeFilter, userData: { part: "fork" },
  });
  setMass(fork, 3, { x: GEOM.forkUp.x * 0.15, y: GEOM.forkUp.y * 0.15 }, 0.03);
  const forkJoint = world.createJoint(new planck.PrismaticJoint({
    bodyA: chassis, bodyB: fork,
    localAnchorA: planck.Vec2(GEOM.frontAxleExt.x, GEOM.frontAxleExt.y), localAnchorB: planck.Vec2(0, 0),
    localAxisA: planck.Vec2(GEOM.forkUp.x, GEOM.forkUp.y), referenceAngle: 0,
    enableLimit: true, lowerTranslation: 0, upperTranslation: GEOM.frontTravel,
  }));

  const makeWheel = (pos, mass, part) => {
    const wheel = world.createBody({ type: "dynamic", position: pos, angle: 0, bullet: true });
    wheel.createFixture(new planck.CircleShape(GEOM.wheelR), {
      density: 1, friction: 1.1, restitution: 0.12, ...bikeFilter, userData: { part, wheel: true },
    });
    setMass(wheel, mass, { x: 0, y: 0 }, 0.55 * mass * GEOM.wheelR * GEOM.wheelR);
    wheel.setAngularDamping(0.04);
    return wheel;
  };
  const rearPos = W(localToWorldRel(GEOM.pivot, GEOM.swingRest, { x: -L, y: 0 }));
  const rearWheel = makeWheel(rearPos, 10.5, "rearWheel");
  const frontWheel = makeWheel(W(GEOM.frontAxleExt), 9, "frontWheel");
  const rearHub = world.createJoint(new planck.RevoluteJoint({
    bodyA: swing, bodyB: rearWheel,
    localAnchorA: planck.Vec2(-L, 0), localAnchorB: planck.Vec2(0, 0),
    enableMotor: true, maxMotorTorque: 0, motorSpeed: 0,
  }));
  const frontHub = world.createJoint(new planck.RevoluteJoint({
    bodyA: fork, bodyB: frontWheel,
    localAnchorA: planck.Vec2(0, 0), localAnchorB: planck.Vec2(0, 0),
    enableMotor: true, maxMotorTorque: 0, motorSpeed: 0,
  }));

  return {
    chassis, swing, fork, rearWheel, frontWheel, pivotJoint, forkJoint, rearHub, frontHub,
    bodies: [chassis, swing, fork, rearWheel, frontWheel],
    rearContacts: 0, frontContacts: 0,
    throttle: 0, rpm: 1700, gear: 1, reverse: false, reverseHold: 0, frontComp: 0, rearComp: 0, speedAlong: 0,
  };
}

// A point given in a sub-frame (origin `o`, rotated `a`) expressed in bike-local metres.
function localToWorldRel(o, a, p) {
  const r = rot(p, a);
  return { x: o.x + r.x, y: o.y + r.y };
}

const GEAR_TOP = [0, 30, 45, 62, 79, 96]; // wheel rad/s at the rev limit per gear
const REDLINE = 12000;
const IDLE = 1700;

// Per physics step: engine, brakes, springs, dampers, air drag.
export function driveBike(bike, input, tune, h) {
  const { chassis, swing, fork, rearHub, frontHub, pivotJoint, forkJoint } = bike;

  // Twist of the wrist: the throttle opens and closes over a few hundredths of a second.
  const target = input.throttle ? 1 : 0;
  bike.throttle += clamp(target - bike.throttle, -h * 10, h * 1.8);

  const wheelSpin = -rearHub.getJointSpeed(); // forward rotation is clockwise
  const speedAlong = planck.Vec2.dot(chassis.getLinearVelocity(), chassis.getWorldVector(planck.Vec2(1, 0)));

  // Reverse: hold the brake once stopped and the bike creeps backwards.
  if (input.brake && Math.abs(speedAlong) < 0.6) bike.reverseHold += h;
  else if (!input.brake) bike.reverseHold = 0;
  bike.reverse = input.brake && bike.reverseHold > 0.45;

  const maxT = 400 * tune.enginePower;
  const power = 30000 * tune.enginePower;
  const omegaMax = GEAR_TOP[5];
  if (bike.reverse) {
    rearHub.setMotorSpeed(6.5);
    rearHub.setMaxMotorTorque(260);
  } else if (input.brake) {
    rearHub.setMotorSpeed(0);
    rearHub.setMaxMotorTorque(520 * tune.brake);
  } else if (bike.throttle > 0.01) {
    const w = Math.max(wheelSpin, 1);
    const limiter = clamp(1 - Math.pow(Math.max(0, w) / omegaMax, 6), 0, 1);
    const torque = Math.min(maxT, power / w) * limiter * bike.throttle;
    rearHub.setMotorSpeed(-omegaMax);
    rearHub.setMaxMotorTorque(torque);
  } else {
    // Engine braking with the clutch out; the clutch is pulled near a stop.
    rearHub.setMotorSpeed(0);
    rearHub.setMaxMotorTorque(Math.abs(wheelSpin) > 4 ? 55 : 3);
  }
  frontHub.setMotorSpeed(0);
  frontHub.setMaxMotorTorque(input.brake && !bike.reverse ? 760 * tune.brake : 1.5);

  // Fork: progressive spring plus compression/rebound damping along the tube.
  const t = forkJoint.getJointTranslation();
  const tv = forkJoint.getJointSpeed();
  const ft = GEOM.frontTravel;
  let fForce = tune.frontSpring * (t + 0.016) * (1 + 2.4 * Math.pow(Math.max(0, t) / ft, 3));
  fForce += tv > 0 ? 680 * tune.damping * tv : 1150 * tune.damping * tv;
  const axis = chassis.getWorldVector(planck.Vec2(GEOM.forkUp.x, GEOM.forkUp.y));
  const forkPoint = fork.getWorldCenter();
  fork.applyForce(planck.Vec2(-axis.x * fForce, -axis.y * fForce), forkPoint, true);
  chassis.applyForce(planck.Vec2(axis.x * fForce, axis.y * fForce), forkPoint, true);
  bike.frontComp = t / ft;

  // Shock: expressed at the axle, applied as a torque about the swingarm pivot.
  const L = GEOM.swingLen;
  const c = -pivotJoint.getJointAngle() * L;
  const cv = -pivotJoint.getJointSpeed() * L;
  const rt = GEOM.rearTravel;
  let rForce = tune.rearSpring * (c + 0.02) * (1 + 1.8 * Math.pow(Math.max(0, c) / rt, 2));
  rForce += cv > 0 ? 900 * tune.damping * cv : 1500 * tune.damping * cv;
  const torque = rForce * L;
  swing.applyTorque(torque, true);
  chassis.applyTorque(-torque, true);
  bike.rearComp = c / rt;

  // Air drag on bike and rider.
  const v = chassis.getLinearVelocity();
  const sp = v.length();
  if (sp > 0.1) {
    const k = 0.5 * 1.2 * 0.62 * sp;
    chassis.applyForceToCenter(planck.Vec2(-v.x * k, -v.y * k), true);
  }

  // Engine speed for the sound: a 5-speed box that shifts on its own.
  const absSpin = Math.abs(wheelSpin);
  if (bike.gear < 5 && absSpin > GEAR_TOP[bike.gear] * 0.93) bike.gear++;
  else if (bike.gear > 1 && absSpin < GEAR_TOP[bike.gear - 1] * 0.55) bike.gear--;
  const fromWheel = (absSpin / GEAR_TOP[bike.gear]) * REDLINE;
  const clutchSlip = IDLE + bike.throttle * 6500;
  const targetRpm = clamp(Math.max(fromWheel, absSpin < 8 ? clutchSlip * (1 - absSpin / 8) + fromWheel : IDLE), IDLE, REDLINE);
  bike.rpm += (targetRpm - bike.rpm) * Math.min(1, h * 14);
  bike.speedAlong = speedAlong;
  void swing;
}

export function bikeSpeed(bike) {
  return bike.chassis.getLinearVelocity().length();
}
// Side-on follow camera. Leads the bike in the direction of travel, and when
// rider and bike part ways it pulls back to keep both in frame.
import { clamp } from "./rng.js";

export function createCamera(x, y) {
  return { x, y, ppm: 60, shake: 0, shakeT: 0, ox: 0, oy: 0 };
}

export function updateCamera(cam, sim, dt, size, opts) {
  const { W, H } = size;
  if (!W || !H) return;
  const bike = sim.bike.chassis;
  const bp = bike.getPosition();
  const bv = bike.getLinearVelocity();
  const view = opts.viewWidth;
  // Desktop frames show `view` metres across; narrow frames never less than 12 m.
  let ppm = Math.min(W / 12, Math.max(W / view, H / (view * 0.56)));
  let tx;
  let ty;
  if (sim.rider.mode === "riding") {
    tx = bp.x + clamp(bv.x * opts.lookAhead, -2.5, 4.5);
    ty = bp.y + 1.5 + clamp(bv.y * 0.12, -1.5, 1.5);
  } else {
    const t = sim.rider.bodies.torso.getPosition();
    tx = (bp.x + t.x) / 2;
    ty = (bp.y + t.y) / 2 + 1.0;
    const spanX = Math.abs(bp.x - t.x) + 9;
    const spanY = Math.abs(bp.y - t.y) + 6;
    ppm = Math.min(ppm, W / spanX, H / spanY);
  }
  const kx = 1 - Math.exp(-dt * 4.5);
  const ky = 1 - Math.exp(-dt * 3.2);
  const kz = 1 - Math.exp(-dt * 1.8);
  cam.x += (tx - cam.x) * kx;
  cam.y += (ty - cam.y) * ky;
  cam.ppm += (ppm - cam.ppm) * kz;
  // Impact shake decays quickly; a tiny world-space jitter, never a spin.
  cam.shake *= Math.exp(-dt * 7);
  cam.shakeT += dt * 38;
  cam.ox = Math.sin(cam.shakeT * 1.3) * cam.shake * 0.12;
  cam.oy = Math.cos(cam.shakeT * 1.7) * cam.shake * 0.12;
}

export function snapCamera(cam, sim) {
  const p = sim.bike.chassis.getPosition();
  cam.x = p.x;
  cam.y = p.y + 1.1;
}
// The game's Creator Tools vocabulary: what exists (catalog), what is on
// screen (describeScene), and what the editor may drive. Node ids are stable.
import { SECTIONS } from "./track.js";

export function createDevtools({ mount, game }) {
  const rectOf = (el) => {
    const r = el.getBoundingClientRect();
    return { x: r.left, y: r.top, w: r.width, h: r.height };
  };

  return {
    game: "Last Light MX",

    catalog({ definition, keysFor }) {
      return {
        levels: [],
        screens: [],
        definitions: [
          definition("def:bike", "Dirt bike", { tweakKeys: keysFor("def:bike"), nodeKinds: ["bike"], sprite: "BIKE_BODY", category: "characters" }),
          definition("def:rider", "Rider", { tweakKeys: keysFor("def:rider"), nodeKinds: ["rider"], sprite: "RIDER_PARTS", spriteFrame: "helmet", category: "characters" }),
          definition("def:terrain", "Forest trail", { tweakKeys: keysFor("def:terrain"), nodeKinds: ["terrain"], sprite: "DIRT_TEXTURE", category: "world" }),
          definition("def:trail-props", "Rocks and logs", { tweakKeys: keysFor("def:trail-props"), nodeKinds: ["prop"], sprite: "TRAIL_PROPS", spriteFrame: "rock_large", singleton: false, category: "hazards" }),
          definition("def:forest", "Forest", { tweakKeys: keysFor("def:forest"), nodeKinds: ["forest"], sprite: "PINE_TREE", category: "world" }),
          definition("def:backdrop", "Sunset sky", { tweakKeys: keysFor("def:backdrop"), nodeKinds: ["backdrop"], sprite: "SKY_BACKDROP", category: "world" }),
          definition("def:dust", "Dust and roost", { tweakKeys: keysFor("def:dust"), nodeKinds: ["dust"], category: "effects" }),
          definition("def:camera", "Camera", { tweakKeys: keysFor("def:camera"), nodeKinds: ["camera"], category: "system" }),
          definition("def:hud", "HUD", { tweakKeys: keysFor("def:hud"), nodeKinds: ["hud-speed", "hud-records", "hud-legend", "hud-prompt"], category: "interface" }),
        ],
      };
    },

    describeScene() {
      const nodes = [];
      const r = mount.getBoundingClientRect();
      const full = { x: r.left, y: r.top, w: r.width, h: r.height };
      nodes.push({ id: "backdrop", defId: "def:backdrop", kind: "backdrop", label: "Sunset sky", rect: full, instance: {} });
      nodes.push({ id: "forest", defId: "def:forest", kind: "forest", label: "Forest", rect: full, instance: {} });
      const sim = game.run.sim;
      const cam = game.run.cam;
      if (sim && game.canvas) {
        const c = game.canvas.getBoundingClientRect();
        const toRect = (x0, y0, x1, y1) => ({
          x: c.left + c.width / 2 + (x0 - cam.x) * cam.ppm,
          y: c.top + c.height / 2 - (y1 - cam.y) * cam.ppm,
          w: (x1 - x0) * cam.ppm,
          h: (y1 - y0) * cam.ppm,
        });
        nodes.push({ id: "terrain", defId: "def:terrain", kind: "terrain", label: "Forest trail", rect: { x: c.left, y: c.top + c.height / 2, w: c.width, h: c.height / 2 }, instance: { section: game.state.section } });
        const halfW = c.width / 2 / cam.ppm;
        for (const p of sim.track.props) {
          if (Math.abs(p.x - cam.x) > halfW + 3) continue;
          const hw = p.type === "log" ? p.len / 2 : p.rx;
          const hh = p.type === "log" ? p.r : p.ry;
          nodes.push({ id: p.id, defId: "def:trail-props", kind: "prop", label: p.type, rect: toRect(p.x - hw, p.y - hh, p.x + hw, p.y + hh), instance: { type: p.type, x: p.x } });
        }
        const bp = sim.bike.chassis.getPosition();
        nodes.push({ id: "bike", defId: "def:bike", kind: "bike", label: "Dirt bike", rect: toRect(bp.x - 1.1, bp.y - 0.5, bp.x + 1.1, bp.y + 0.9), instance: { speedKmh: Math.round(game.state.speedKmh), rpm: Math.round(sim.bike.rpm), gear: sim.bike.gear } });
        let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
        for (const b of sim.rider.list) {
          const p = b.getPosition();
          x0 = Math.min(x0, p.x); y0 = Math.min(y0, p.y); x1 = Math.max(x1, p.x); y1 = Math.max(y1, p.y);
        }
        nodes.push({ id: "rider", defId: "def:rider", kind: "rider", label: "Rider", rect: toRect(x0 - 0.2, y0 - 0.2, x1 + 0.2, y1 + 0.2), instance: { state: sim.rider.mode, grips: sim.rider.grips.filter((g) => g.joint).length } });
        if (sim.particles.length) nodes.push({ id: "dust", defId: "def:dust", kind: "dust", label: "Dust", rect: toRect(bp.x - 3, bp.y - 1, bp.x + 1, bp.y + 1.5), instance: { particles: sim.particles.length } });
        nodes.push({ id: "camera", defId: "def:camera", kind: "camera", label: "Camera", rect: { x: c.left, y: c.top, w: c.width, h: c.height }, instance: { metresAcross: Math.round(c.width / cam.ppm) } });
      }
      const hud = [
        [".hud-speed", "hud-speed", "Speed and place"],
        [".hud-records", "hud-records", "Personal records"],
        [".legend", "hud-legend", "Key legend"],
        [".prompt:not([hidden])", "hud-prompt", "Pick-up prompt"],
      ];
      for (const [sel, kind, label] of hud) {
        const el = mount.querySelector(sel);
        if (el) nodes.push({ id: kind, defId: "def:hud", kind, label, rect: rectOf(el), instance: {} });
      }
      return { nodes };
    },

    getState: () => ({
      speedKmh: Math.round(game.state.speedKmh),
      distance: Math.round(game.state.distance),
      section: game.state.section,
      sectionIndex: SECTIONS.findIndex((s) => s.name === game.state.section),
      rider: game.state.riderState,
      bestJump: Math.round(game.state.bestJump * 10) / 10,
      bestAir: Math.round(game.state.bestAir * 10) / 10,
      bestWreck: Math.round(game.state.bestWreck),
      loading: game.state.loading,
    }),

    commands: {
      "pick-up-bike": {
        label: "Pick up the bike",
        icon: "Bike",
        description: "Stand the bike up where it lies and put the rider back on (after a crash)",
        mutates: true,
        run: () => game.pickUpBike(),
      },
      "bail-off": {
        label: "Bail off",
        icon: "PersonStanding",
        description: "The rider lets go and pushes off the bike",
        mutates: true,
        run: () => game.bailOff(),
      },
      "ride-from-clearing": {
        label: "Start at The Clearing",
        icon: "Mountain",
        description: "Put the bike at the start of the big jumps",
        mutates: true,
        run: () => game.rideFromSection(2),
      },
      "ride-from-gap": {
        label: "Start at The Gap",
        icon: "MoveHorizontal",
        description: "Put the bike at the run-in to the ravine gap",
        mutates: true,
        run: () => game.rideFromSection(6),
      },
      "ride-from-start": {
        label: "Back to the trailhead",
        icon: "RotateCcw",
        description: "Put the bike and rider back at Pine Gate",
        mutates: true,
        run: () => game.rideFromStart(),
      },
    },
  };
}
// Spine of the game: builds the trail and its forest once, loads the art,
// runs the physics sandbox inside the SDK loop, and turns what the physics
// reports (landings, wrecks, impacts) into sound, call-outs and records.
import { loadArt } from "./assets.js";
import { createAudio } from "./audio.js";
import { createCamera, snapCamera, updateCamera } from "./camera.js";
import { createHud } from "./hud.js";
import { createInput } from "./input.js";
import { createRecords } from "./records.js";
import { createRenderer } from "./render.js";
import { buildScenery } from "./scenery.js";
import { bail, canPickUp, createSim, pickUp, pump, setGravity, spawnAt, stepSim } from "./sim.js";
import { buildTrack, END_ZONE_X, SECTIONS, sectionIndexAt, SPAWN_X } from "./track.js";

export function createGame({ mount, sdk, ready, tweaks, assets }) {
  // Plain summary of the run for hooks and the Creator Tools; the physics
  // world itself lives on `run` below and is rebuilt by init.
  const state = {
    loading: true, error: null,
    speedKmh: 0, distance: 0, section: SECTIONS[0].name, riderState: "riding",
    bestJump: 0, bestAir: 0, bestWreck: 0,
    popups: [], card: null, prompt: "", used: {}, freshRecord: null,
    time: 0,
  };

  const root = document.createElement("div");
  root.className = "game-root";
  const canvas = document.createElement("canvas");
  canvas.className = "game-canvas";
  root.appendChild(canvas);
  const hud = createHud(root);
  const loading = document.createElement("div");
  loading.className = "loading";
  loading.innerHTML = `<div class="loading-inner"><span class="loading-dot"></span><span class="loading-text">Heading into the forest…</span></div>`;
  root.appendChild(loading);
  mount.replaceChildren(root);

  const track = buildTrack();
  const scenery = buildScenery();
  const input = createInput(window);
  const audio = createAudio(sdk);
  const records = createRecords(sdk);
  let renderer = null;

  const run = { sim: null, cam: createCamera(SPAWN_X, 1.5), discovered: new Set(), fade: 0, fadeAction: null, popupId: 0, freshT: 0 };

  const tune = () => ({
    enginePower: tweaks.get("enginePower"),
    grip: tweaks.get("tyreGrip"),
    frontSpring: tweaks.get("frontSpring"),
    rearSpring: tweaks.get("rearSpring"),
    damping: tweaks.get("suspensionDamping"),
    brake: tweaks.get("brakeStrength"),
    gripStrength: tweaks.get("gripStrength"),
    muscle: tweaks.get("muscleStrength"),
    leanReach: tweaks.get("leanReach"),
    gravity: tweaks.get("gravity"),
    dust: tweaks.get("dustAmount"),
  });
  const applyVolume = () => audio.setVolume(Number(tweaks.get("masterVolume")), Boolean(tweaks.get("muted")));
  applyVolume();
  const unsubscribes = [
    tweaks.subscribe("masterVolume", applyVolume),
    tweaks.subscribe("muted", applyVolume),
    tweaks.subscribe("gravity", (g) => run.sim && setGravity(run.sim, Number(g))),
  ];

  loadArt(assets)
    .then((res) => {
      renderer = createRenderer(canvas, res, track, scenery);
      renderer.resize();
      state.loading = false;
      loading.hidden = true;
    })
    .catch((err) => {
      console.error(err);
      state.error = String(err.message || err);
      loading.querySelector(".loading-text").textContent = "The forest didn't load. Reload to try again.";
      loading.classList.add("failed");
    });

  const ro = new ResizeObserver(() => renderer && renderer.resize());
  ro.observe(canvas);

  // First key or click wakes the sound; the press still does its job.
  const wake = () => audio.unlock();
  window.addEventListener("keydown", wake, true);
  window.addEventListener("pointerdown", wake, true);

  function showCard(kicker, name) {
    state.card = { kicker, name, t: 0, life: 3.2 };
  }

  function popup(kind, main, sub, x, y, best) {
    state.popups.push({ id: ++run.popupId, kind, main, sub, x, y, t: 0, life: kind === "wreck" ? 2.8 : 2.4, best });
  }

  // ---- Actions the game performs on demand (Creator Tools call these too) --
  function pickUpBike() {
    if (!run.sim || run.fade > 0) return false;
    if (!canPickUp(run.sim)) return false;
    run.fadeAction = "pickup";
    run.fade = 0.0001;
    return true;
  }
  function rideFromStart() {
    if (!run.sim || run.fade > 0) return false;
    run.fadeAction = "start";
    run.fade = 0.0001;
    return true;
  }
  // Drop the bike at the start of a trail section (Creator Tools shortcut).
  function rideFromSection(index) {
    const sec = SECTIONS[Math.max(0, Math.min(SECTIONS.length - 1, index | 0))];
    if (!run.sim) return false;
    spawnAt(run.sim, Math.max(SPAWN_X, sec.x0 + 6));
    snapCamera(run.cam, run.sim);
    run.discovered.add(sec.id);
    return true;
  }
  function bailOff() {
    return run.sim ? bail(run.sim) : false;
  }
  function pumpBody() {
    if (run.sim) pump(run.sim);
  }

  function atTrailEnd() {
    const s = run.sim;
    return s.rider.mode === "riding" && s.bike.chassis.getPosition().x > END_ZONE_X && s.bike.chassis.getLinearVelocity().length() < 4;
  }

  function handleEvents(sim) {
    for (const e of sim.events) {
      if (e.type === "impact") {
        const w = Math.min(1, e.impulse / 260);
        if (e.kind === "body") {
          audio.thud(w);
          run.cam.shake = Math.max(run.cam.shake, w * 1.2);
        } else if (e.kind === "bike") {
          audio.clank(Math.min(1, e.impulse / 350));
          run.cam.shake = Math.max(run.cam.shake, w);
        } else if (e.kind === "wheel" && e.impulse > 120) {
          audio.thud(Math.min(1, e.impulse / 600) * 0.7, 0.8);
          run.cam.shake = Math.max(run.cam.shake, Math.min(0.8, e.impulse / 900));
        }
      } else if (e.type === "jump") {
        if (e.air < 0.6) continue;
        const beat = records.jump(e.dist, e.air);
        const best = beat.dist || beat.air;
        popup("jump", `${e.dist.toFixed(1)} m`, best ? (beat.dist ? "New best jump" : "Most air yet") : `${e.air.toFixed(1)} s air`, e.x, e.y + 1.6, best);
        if (best) {
          audio.chime();
          state.freshRecord = beat.dist ? "jump" : "air";
          run.freshT = 2.5;
        }
      } else if (e.type === "wreck") {
        if (e.g < 1) continue;
        const best = records.wreck(e.g);
        const label = e.cause === "bail" ? "Bailed" : e.g > 25 ? "Big wreck" : e.g > 10 ? "Wreck" : "Tip-over";
        popup("wreck", `${Math.round(e.g)} g`, best ? "Hardest wreck yet" : label, e.x, e.y + 1.4, best);
        if (best) {
          state.freshRecord = "wreck";
          run.freshT = 2.5;
        }
      } else if (e.type === "crash") {
        run.cam.shake = Math.max(run.cam.shake, Math.min(1.4, e.speed / 12));
      }
    }
    sim.events.length = 0;
  }

  const hooks = {
    // Build or reset the run: fresh physics world, bike and rider at the trailhead.
    init(s) {
      const sim = createSim(track, tune());
      run.sim = sim;
      sim.events.length = 0;
      snapCamera(run.cam, sim);
      run.discovered = new Set([SECTIONS[0].id]);
      run.fade = 0;
      run.fadeAction = null;
      input.clear();
      s.popups = [];
      s.card = null;
      s.prompt = "";
      s.time = 0;
      s.riderState = "riding";
      showCard("Golden hour", SECTIONS[0].name);
    },

    update(s, dt) {
      const sim = run.sim;
      if (!sim || s.loading) return;
      s.time += dt;
      input.tick(dt);
      sim.tune = tune();

      // Queued presses.
      const q = input.queued;
      if (q.pickUp) {
        if (atTrailEnd()) rideFromStart();
        else pickUpBike();
      }
      if (q.bail) bailOff();
      if (q.pump) pumpBody();
      q.pickUp = q.bail = q.pump = false;

      // Fade to black and back for picking the bike up.
      if (run.fade > 0) {
        const before = run.fade;
        run.fade += dt / 0.28;
        if (before < 1 && run.fade >= 1) {
          if (run.fadeAction === "pickup") pickUp(sim);
          else if (run.fadeAction === "start") spawnAt(sim, SPAWN_X);
          snapCamera(run.cam, sim);
        }
        if (run.fade >= 2) run.fade = 0;
      }

      stepSim(sim, dt, input);
      handleEvents(sim);
      updateCamera(run.cam, sim, dt, renderer ? renderer.size() : { W: 0, H: 0 }, {
        viewWidth: tweaks.get("viewWidth"),
        lookAhead: tweaks.get("lookAhead"),
      });

      const bike = sim.bike;
      const bp = bike.chassis.getPosition();
      const speed = bike.chassis.getLinearVelocity().length();
      s.speedKmh = speed * 3.6;
      s.distance = bp.x - SPAWN_X;
      const si = sectionIndexAt(bp.x);
      s.section = SECTIONS[si].name;
      if (!run.discovered.has(SECTIONS[si].id) && sim.rider.mode === "riding") {
        run.discovered.add(SECTIONS[si].id);
        showCard(`${Math.round(Math.max(0, s.distance))} m`, SECTIONS[si].name);
      }
      if (sim.rider.mode === "riding") records.farthest(bp.x);
      s.riderState = sim.rider.mode;
      s.bestJump = records.rec.bestJump;
      s.bestAir = records.rec.bestAir;
      s.bestWreck = records.rec.bestWreck;
      s.used = { ...input.used };
      s.prompt = run.fade > 0 ? "" : canPickUp(sim) ? "Pick up the bike" : atTrailEnd() ? "Ride again from Pine Gate" : "";

      if (s.card) s.card.t += dt;
      for (const p of s.popups) p.t += dt;
      s.popups = s.popups.filter((p) => p.t < p.life);
      run.freshT -= dt;
      if (run.freshT <= 0) s.freshRecord = null;

      // Sound follows the machine.
      const crashT = sim.crash ? sim.crash.t : 0;
      let slip = 0;
      if (bike.rearContacts > 0) slip = Math.abs(bike.rearWheel.getAngularVelocity() * 0.345 + bike.speedAlong);
      audio.update(dt, {
        rpm: bike.rpm, throttle: sim.rider.mode === "riding" ? bike.throttle : 0,
        engineOn: !(sim.crash && crashT > 1.4), speed, slip,
        rolling: bike.rearContacts + bike.frontContacts > 0 ? speed : 0,
        time: s.time,
      });
    },

    render(s) {
      if (!renderer || !run.sim) return;
      const cam = run.cam;
      const view = {
        sim: run.sim,
        cam: { x: cam.x + cam.ox, y: cam.y + cam.oy, ppm: cam.ppm },
        time: s.time,
        warmth: Number(tweaks.get("sunWarmth")),
        debug: Boolean(tweaks.get("showPhysics")),
        fade: run.fade > 0 ? 1 - Math.abs(1 - run.fade) : 0,
      };
      renderer.draw(view);
      const { W, H } = renderer.size();
      hud.render(s, (x, y) => ({ x: W / 2 + (x - view.cam.x) * view.cam.ppm, y: H / 2 - (y - view.cam.y) * view.cam.ppm }));
    },
  };

  return {
    state,
    hooks,
    run,
    pickUpBike,
    rideFromStart,
    rideFromSection,
    bailOff,
    pumpBody,
    canvas,
    hud,
    destroy() {
      for (const u of unsubscribes) u();
      ro.disconnect();
      input.destroy();
      audio.destroy();
      window.removeEventListener("keydown", wake, true);
      window.removeEventListener("pointerdown", wake, true);
      mount.replaceChildren();
    },
    sdk,
    ready,
    tweaks,
    assets,
  };
}
